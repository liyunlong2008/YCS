# =============================================================================
# 云龙挑战赛（YCS）配置模板 · config.yaml.example
# 使用：cp config.yaml.example config.yaml 后再修改 config.yaml
#
# 注意：
#   · config.yaml 已加入 .gitignore，不会提交到仓库（避免 OKX / AI 密钥泄露）
#   · install.sh / ycsctl check 缺失 config.yaml 时会自动 cp 本模板生成一份
#   · 所有占位值（YOUR_XXX）用于本地纸盘观察，实盘前必须替换成真实凭证
# =============================================================================

# OKX API 凭证（实盘必填；纸盘模式可保持占位）
okx:
  api_key: "YOUR_OKX_API_KEY"
  secret: "YOUR_OKX_API_SECRET"
  passphrase: "YOUR_OKX_PASSPHRASE"

# AI 提供商配置（通过 LiteLLM 统一接入；纸盘无网络时自动降级为离线兜底模型）
ai:
  provider: "deepseek"        # deepseek / openai / claude / gemini / openrouter
  api_key: "YOUR_AI_API_KEY"
  model: "deepseek-chat"      # 更换模型时仅修改此处
  base_url: ""                # 可选，自定义 endpoint

# 交易运行模式
trading:
  live: false                 # false=纸盘模式(Paper)   true=实盘模式(Live)
  symbol: "ETH-USDT-SWAP"     # 单品种

# 实盘硬风控阈值（按用户当前账户 14.8 USDT 保守配置，护栏 A1/A2/A3/A5/A7）
risk_limits:
  # A1. 本金上限硬锁：系统用到的总资产绝不超过此数（你充值再多也只当这部分用）
  live_max_equity_usdt: 15.0
  # A2. 每日亏损熔断（USDT 绝对值，比百分比更稳）：当日累计 realized + unrealized <= -3.0U → 全平 + 停机
  live_max_daily_loss_usdt: 3.0
  # A3. 单笔下单名义上限 & 仓位变动率上限（0 加到 N 的变化 ÷ 总资产 ≤ position_change_pct）
  live_max_single_order_usdt: 2.0
  position_change_pct: 0.10   # 10%：不能一口吃成胖子
  # A5. Kill-Switch API Token（POST /api/kill 时用 X-YCS-Admin-Token: <这里的值>；生产必须改成 32 位随机串）
  kill_switch_token: "YCS_KILL_CHANGEME_32BYTES_RANDOM_STRING_PLEASE"
  # A7. 影子模式（观察模式）：true = 生成完整订单但绝不真发（用于链路联调 6 小时再切 live=true）
  shadow_mode: false
  # A5 副参数：Kill-Switch HTTP 通道超时秒数；开启后触发 Kill 会触发全平
  kill_panic_flatten: true
  kill_http_timeout_s: 3
  emergency_halt_file: "data/EMERGENCY_HALT"

# Dashboard / API 监听配置
server:
  host: "127.0.0.1"
  port: 8765               # 2026-08-30 统一改为 8765（生产默认；对外 Nginx/Cloudflare 另配）
  ui_port: 8080

# 日志
logging:
  level: "INFO"
  file: "logs/app.log"

# 存储路径（交易 journal / 总账 ledger）
storage:
  journal_dir: "data/journal"
  ledger_file: "data/ledger.jsonl"
